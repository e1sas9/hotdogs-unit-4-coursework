# SEARCH FUNCTIONS

def linear_search(items, target):
    for i in range(len(items)):
        if items[i] == target:
            return i
    return -1


def binary_search(items, target):
    first = 0
    last = len(items) - 1

    while first <= last:
        midpoint = (first + last) // 2

        if items[midpoint] == target:
            return midpoint
        elif items[midpoint] < target:
            first = midpoint + 1
        else:
            last = midpoint - 1

    return -1


